package require tcltest
namespace import ::tcltest::*

# POST /api/v2/programs {id,execute:true}: runs a program, and the description / isOperable / isCopy fields of the
# model's programs. The ReGa scripts themselves are proven on a real ReGa (see the commit message); here: the
# validation, the access rules, the error codes and that only a program of the program collection can be run.
set here [file dirname [file normalize [info script]]]
set gen [file dirname [file dirname $here]]
source [file join $gen schema-harness tests helpers mocks.tcl]
# the component code lives in ::mock::generated (the tests tree is not the code tree in the repository)
set gen $::mock::generated
source [file join $gen schema-harness tests helpers golden.tcl]

set CAND only:dispatcher,security-session,rega-model
proc status {r} {
  if {[regexp {Status: (\d+)} [dict get $r headers] -> s]} { return $s }
  return 200
}
proc err {r} {
  if {[regexp {"code": (\d+),\s*"message": "((?:[^"\\]|\\.)*)"} [dict get $r body] -> c m]} { return [list [status $r] $c $m] }
  return [list [status $r] none]
}
set GUEST {{AbCdEf1234 1 1000 Guest}}
set USER  {{AbCdEf1234 2 1000 User}}
set ADMIN {{AbCdEf1234 8 1000 Admin}}
set READ  {*FOUND*}
set RUN   {*ProgramExecute*}
set OKOUT {OK {true} TIME {2026-10-31 21:10:00}}
set FOUND {FOUND {true} INTERNAL {false} COPY {false} FULL {true}}
proc post {body args} {
  array set o [list -sessions $::ADMIN -rega {} -method POST]
  array set o $args
  return [golden::call_raw $body [golden::prepare [list -candidate $::CAND -method $o(-method) -contenttype application/json -setenv {REQUEST_URI /api/v2/programs} \
    -header {X-Requested-With XMLHttpRequest} -header {X-Session-Id AbCdEf1234} -sessions $o(-sessions) -rega $o(-rega)]]]
}
proc run {found body args} {
  array set o [list -sessions $::ADMIN -out $::OKOUT]
  array set o $args
  return [post $body -sessions $o(-sessions) -rega [list [list $::READ $found] [list $::RUN $o(-out)]]]
}
proc body {r} { return [string trim [dict get $r body]] }
proc progcalls {r} { set n 0; foreach c [dict get $r rega_calls] { if {[string match {*ID_PROGRAMS*} $c] || [string match {*CreateObject*} $c] || [string match {*progName*} $c]} { incr n } }; return $n }
proc scripts {r} { return [join [dict get $r rega_calls] \n] }

test programs-0 {the handler file exists, is complete Tcl and the route is registered} -body {
  set fd [open [file join $gen rega-model v2 programs.tcl] r]; set c [read $fd]; close $fd
  set fd [open [file join $gen dispatcher v2 router.tcl] r]; set r [read $fd]; close $fd
  list [info complete $c] [regexp {/programs\s+\{\{GET POST PUT DELETE\}\s+programs.tcl\s+v2_programs_handle\}} $r]
} -result {1 1}

test programs-1 {a program is run and the time of its last run comes back from ReGa} -body {
  set r [run $::FOUND {{"id":"1053","execute":true}}]
  set r2 [run $::FOUND {{"id":"1053","execute":"true"}}]
  list [status $r] [body $r] [status $r2]
} -result [list 200 {{"id":"1053","executed":true,"lastExecuteTime":"2026-10-31 21:10:00"}} 200]

test programs-2 {ReGa answering false for the run is reported as executed:false (HTTP 200)} -body {
  body [run $::FOUND {{"id":"7","execute":true}} -out {OK {false} TIME {2026-10-31 21:10:00}}]
} -result {{"id":"7","executed":false,"lastExecuteTime":"2026-10-31 21:10:00"}}

test programs-3 {the body: execute must be true, id digits only, no other keys (isActive is not built), not JSON is 400} -body {
  set out {}
  foreach json {{{"id":"7","execute":false}} {{"id":"7"}} {{"id":"7","execute":"yes"}} {{"id":"7a","execute":true}} {{"execute":true}} {{"id":"7","execute":true,"isActive":true}} {{"id":"7","execute":true,"name":"x"}}} {
    lappend out [err [run $::FOUND $json]]
  }
  lappend out [err [run $::FOUND {{nope}}]]
} -result [list {422 403 {invalid argument (execute)}} {422 403 {invalid argument (execute)}} {422 403 {invalid argument (execute)}} {422 403 {invalid argument (id)}} {422 403 {invalid argument (id)}} {422 403 {invalid argument (isActive)}} {422 403 {invalid argument (name)}} {400 100 {invalid request (\" expected)}}]

test programs-4 {an id that is not in the program collection is HTTP 404 and nothing is run; a program copy is not found either} -body {
  set a [post {{"id":"950","execute":true}} -rega [list [list $::READ {}]]]
  set b [run {FOUND {true} INTERNAL {false} COPY {true} FULL {true}} {{"id":"7","execute":true}}]
  list [err $a] [regexp {ProgramExecute} [scripts $a]] [err $b] [regexp {ProgramExecute} [scripts $b]]
} -result {{404 501 {program not found}} 0 {404 501 {program not found}} 0}

test programs-5 {an internal program is refused with HTTP 403 and not run} -body {
  set r [run {FOUND {true} INTERNAL {true} COPY {false} FULL {true}} {{"id":"7","execute":true}}]
  list [err $r] [regexp {ProgramExecute} [scripts $r]]
} -result {{403 400 {access denied (program)}} 0}

test programs-6 {a user needs the full access right, an administrator does not; a guest never runs anything} -body {
  set noRight {FOUND {true} INTERNAL {false} COPY {false} FULL {false}}
  set a [run $noRight {{"id":"7","execute":true}} -sessions $::USER]
  set b [run $noRight {{"id":"7","execute":true}} -sessions $::ADMIN]
  set c [run $::FOUND {{"id":"7","execute":true}} -sessions $::USER]
  set d [run $::FOUND {{"id":"7","execute":true}} -sessions $::GUEST]
  list [err $a] [status $b] [status $c] [err $d] [regexp {ID_PROGRAMS} [scripts $d]]
} -result {{403 400 {access denied (program)}} 200 200 {403 400 {access denied (\"USER\" needed, session level 1)}} 0}

test programs-7 {only GET, POST, PUT and DELETE are allowed (PATCH is 405 with that Allow list); without a session HTTP 401 and no ReGa script runs} -body {
  set out {}
  foreach m {PATCH} {
    set r [post {} -method $m]
    regexp {Allow: ([^\r\n]+)} [dict get $r headers] -> allow
    lappend out [status $r]/$allow
  }
  set n [golden::call_raw {{"id":"7","execute":true}} [golden::prepare [list -candidate $::CAND -method POST -contenttype application/json -setenv {REQUEST_URI /api/v2/programs} -header {X-Requested-With XMLHttpRequest} -sessions $::ADMIN]]]
  lappend out [status $n] [llength [dict get $n rega_calls]]
} -result {{405/GET, POST, PUT, DELETE} 401 0}

test programs-8 {the scripts (read, run, switch, describe, change, copy, delete) look the id up in the program collection and the id is a script variable, never code} -body {
  set fd [open [file join $gen rega-model v2 programs.tcl] r]; set c [read $fd]; close $fd
  list [regexp -all {foreach\(i, dom.GetObject\(ID_PROGRAMS\).EnumIDs\(\)\)} $c] [regexp {dom.GetObject\(\$} $c] [regexp -all {ProgramExecute\(\)} $c]
} -result {8 0 1}

proc modelprograms {extra} {
  set rec [concat {ID 1053 NAME Evening TIME {2026-10-12 21:00:00} ACTIVE true INTERNAL false} $extra]
  return [golden::call_raw {} [golden::prepare [list -candidate $::CAND -method GET -contenttype {} -setenv {REQUEST_URI /api/v2/model} -query sections=programs \
    -header {X-Requested-With XMLHttpRequest} -header {X-Session-Id AbCdEf1234} -sessions $::USER -rega [list [list {*ID_PROGRAMS*PrgInfo*} [list $rec]]]]]]
}

test programs-9 {the model's programs carry the description, whether users may operate them and whether they are copies (defaults: empty, false, false)} -body {
  set a [body [modelprograms {INFO {Licht am Abend} OPERABLE true COPY false}]]
  set b [body [modelprograms {INFO x OPERABLE false COPY true VISIBLE false}]]
  set c [body [modelprograms {}]]
  list [regexp {"lastExecuteTime":"2026-10-12 21:00:00","description":"Licht am Abend","isOperable":true,"isCopy":false,"isVisible":true\}} $a] \
       [regexp {"isOperable":false,"isCopy":true,"isVisible":false\}} $b] [regexp {"description":"","isOperable":false,"isCopy":false,"isVisible":true\}} $c]
} -result {1 1 1}

set SETACT {*newActive*}
proc setactive {found body args} {
  array set o [list -sessions $::ADMIN -out {ACTIVE {false}}]
  array set o $args
  return [post $body -sessions $o(-sessions) -rega [list [list $::READ $found] [list $::SETACT $o(-out)]]]
}

test programs-10 {an administrator switches a program off and on: the flag as ReGa holds it comes back} -body {
  set a [setactive $::FOUND {{"id":"7","active":false}}]
  set b [setactive $::FOUND {{"id":"7","active":true}} -out {ACTIVE {true}}]
  list [status $a] [body $a] [status $b] [body $b] [regexp {var newActive = "false";} [scripts $a]] [regexp {var newActive = "true";} [scripts $b]]
} -result {200 {{"id":"7","isActive":false}} 200 {{"id":"7","isActive":true}} 1 1}

test programs-11 {switching is the editor's job: a user and a guest are refused (HTTP 403, administrator needed) and nothing is written} -body {
  set a [setactive $::FOUND {{"id":"7","active":false}} -sessions $::USER]
  set b [setactive $::FOUND {{"id":"7","active":false}} -sessions $::GUEST]
  list [err $a] [regexp {newActive} [scripts $a]] [status $b] [regexp {newActive} [scripts $b]]
} -result {{403 400 {access denied (\"ADMIN\" needed, session level 2)}} 0 403 0}

test programs-12 {exactly one of execute and active; active must be a boolean; a wrong body writes nothing} -body {
  set out {}
  foreach json {{{"id":"7","active":false,"execute":true}} {{"id":"7","active":"yes"}} {{"id":"7","active":1}} {{"id":"7","active":null}}} {
    set r [setactive $::FOUND $json]
    lappend out [err $r] [regexp {newActive} [scripts $r]]
  }
  set out
} -result [list {422 403 {invalid argument (execute)}} 0 {422 403 {invalid argument (active)}} 0 {422 403 {invalid argument (active)}} 0 {422 403 {invalid argument (active)}} 0]

test programs-13 {an internal program is not switched (HTTP 403), an unknown id or a copy is 404, as for a run} -body {
  set a [setactive {FOUND {true} INTERNAL {true} COPY {false} FULL {true}} {{"id":"7","active":false}}]
  set b [post {{"id":"9999","active":false}} -rega [list [list $::READ {}]]]
  set c [setactive {FOUND {true} INTERNAL {false} COPY {true} FULL {true}} {{"id":"7","active":false}}]
  list [err $a] [err $b] [err $c] [regexp {newActive} [scripts $a][scripts $b][scripts $c]]
} -result {{403 400 {access denied (program)}} {404 501 {program not found}} {404 501 {program not found}} 0}

test programs-14 {the script looks the id up in the program collection; the value is a string variable and ReGa is only asked to set it with a fixed script} -body {
  set fd [open [file join $gen rega-model v2 programs.tcl] r]; set c [read $fd]; close $fd
  regexp {proc programs_setActive.*?\n\}\n} $c body
  list [regexp {foreach\(i, dom.GetObject\(ID_PROGRAMS\).EnumIDs\(\)\)} $body] [regexp {p.Active\(true\)} $body] [regexp {p.Active\(newActive\)} $body] [regexp {dom.GetObject\(\$} $body]
} -result {1 1 0 0}

# ---- program management: create, copy, change, delete (administrators only)
set DESCRIBE {*PrgInfo()*}
set NAMECHK  {*progExcept*}
set CREATE   {*CreateObject*}
set COPYTO   {*ProgramCopyTo*}
set UPDATE   {*setVisible*}
set DELETE   {*DeleteObject*}
set DESC1 {NAME {Neu} INFO {Text} ACTIVE {false} VISIBLE {true} OPERABLE {false} DONE {true}}
proc manage {method body found args} {
  array set o [list -sessions $::ADMIN -query {} -taken false -extra {}]
  array set o $args
  set rega [list [list $::READ $found] [list $::NAMECHK "TAKEN {$o(-taken)} DONE {true}"] [list $::CREATE {ID {2001} ADDED {true}}] \
    [list $::COPYTO {ID {2002}}] [list $::UPDATE {DONE {true}}] [list $::DELETE {DELETED {true}}] [list $::DESCRIBE $::DESC1]]
  return [golden::call_raw $body [golden::prepare [list -candidate $::CAND -method $method -contenttype application/json -setenv {REQUEST_URI /api/v2/programs} -query $o(-query) \
    -header {X-Requested-With XMLHttpRequest} -header {X-Session-Id AbCdEf1234} -sessions $o(-sessions) -rega $rega]]]
}

test programs-20 {an administrator creates an empty program: the answer is what ReGa holds, the name and text are script variables} -body {
  set r [manage POST {{"create":true,"name":"Neu","description":"Text"}} {}]
  list [status $r] [body $r] [regexp {var progName = "Neu";} [scripts $r]] [regexp {var progInfo = "Text";} [scripts $r]] [regexp {Active\(false\)} [scripts $r]]
} -result [list 200 {{"id":"2001","name":"Neu","description":"Text","isActive":false,"isVisible":true,"isOperable":false}} 1 1 1]

test programs-21 {create and copy are for administrators only (a user and a guest are 403) and run nothing} -body {
  set out {}
  foreach s [list $::USER $::GUEST] {
    set r [manage POST {{"create":true,"name":"Neu"}} {} -sessions $s]
    set c [manage POST {{"id":"7","copy":true,"name":"Neu"}} $::FOUND -sessions $s]
    lappend out [status $r] [status $c] [progcalls $r][progcalls $c]
  }
  set out
} -result {403 403 00 403 403 00}

test programs-22 {a name that another ReGa object has is HTTP 409 (error 404) and nothing is created} -body {
  set r [manage POST {{"create":true,"name":"Taken"}} {} -taken true]
  set c [manage POST {{"id":"7","copy":true,"name":"Taken"}} $::FOUND -taken true]
  list [err $r] [regexp {CreateObject} [scripts $r]] [err $c] [regexp {ProgramCopyTo} [scripts $c]]
} -result {{409 404 {name already in use}} 0 {409 404 {name already in use}} 0}

test programs-23 {a bad name or text is HTTP 422 before any script runs} -body {
  set out {}
  foreach json [list {{"create":true}} {{"create":true,"name":""}} {{"create":true,"name":" x"}} \
                {{"create":true,"name":"a\u0001b"}} "{\"create\":true,\"name\":\"[string repeat x 101]\"}" \
                "{\"create\":true,\"name\":\"x\",\"description\":\"[string repeat y 1001]\"}" {{"create":false,"name":"x"}} {{"create":true,"name":"x","id":"7"}} {{"create":true,"name":"x","active":true}}] {
    set r [manage POST $json {}]
    lappend out [lindex [err $r] 0][progcalls $r]
  }
  set out
} -result {4220 4220 4220 4220 4220 4220 4220 4220 4220}

test programs-24 {a copy: the original must exist and not be internal; the copy is a new program switched off} -body {
  set a [manage POST {{"id":"7","copy":true,"name":"Kopie"}} $::FOUND]
  set b [manage POST {{"id":"7","copy":true,"name":"Kopie"}} {FOUND {true} INTERNAL {true} COPY {false} FULL {true}}]
  set c [manage POST {{"id":"950","copy":true,"name":"Kopie"}} {}]
  set d [manage POST {{"id":"7","copy":true}} $::FOUND]
  list [status $a] [body $a] [regexp {var progName = "Kopie";} [scripts $a]] [regexp {Active\(false\)} [scripts $a]] [err $b] [err $c] [err $d]
} -result [list 200 {{"id":"2002","name":"Neu","description":"Text","isActive":false,"isVisible":true,"isOperable":false}} 1 1 {403 400 {access denied (program)}} {404 501 {program not found}} {422 403 {invalid argument (name)}}]

test programs-25 {a change: only the given fields are written; the answer holds all of them} -body {
  set r [manage PUT {{"id":"7","description":"Text","isVisible":true}} $::FOUND]
  set s [scripts $r]
  list [status $r] [body $r] [regexp {var setName = "false";} $s] [regexp {var setInfo = "true";} $s] [regexp {var setVisible = "true";} $s] [regexp {var setOperable = "false";} $s] [regexp {NAMECHK|progExcept} $s]
} -result [list 200 {{"id":"7","name":"Neu","description":"Text","isActive":false,"isVisible":true,"isOperable":false}} 1 1 1 1 0]

test programs-26 {a rename checks the name against all objects but the program itself; nothing is written when it is taken} -body {
  set a [manage PUT {{"id":"7","name":"Taken"}} $::FOUND -taken true]
  set b [manage PUT {{"id":"7","name":"Fresh"}} $::FOUND]
  list [err $a] [regexp {setName} [scripts $a]] [status $b] [regexp {var progExcept = "7";} [scripts $b]] [regexp {var newName = "Fresh";} [scripts $b]]
} -result {{409 404 {name already in use}} 0 200 1 1}

test programs-27 {a bad change is 422: nothing to change, unknown key, bad id or flag, bad name; none of them runs a script} -body {
  set out {}
  foreach json {{{"id":"7"}} {{"id":"7","color":"red"}} {{"id":"x","name":"a"}} {{"name":"a"}} {{"id":"7","isVisible":"yes"}} {{"id":"7","isOperable":1}} {{"id":"7","name":""}} {{"id":"7","execute":true}}} {
    set r [manage PUT $json $::FOUND]
    lappend out [lindex [err $r] 0][progcalls $r]
  }
  set out
} -result {4220 4220 4220 4220 4220 4220 4220 4220}

test programs-28 {a change needs an administrator; an internal program, a copy and an unknown id are refused/not found} -body {
  set a [manage PUT {{"id":"7","name":"x"}} $::FOUND -sessions $::USER]
  set b [manage PUT {{"id":"7","name":"x"}} {FOUND {true} INTERNAL {true} COPY {false} FULL {true}}]
  set c [manage PUT {{"id":"7","name":"x"}} {FOUND {true} INTERNAL {false} COPY {true} FULL {true}}]
  list [status $a] [progcalls $a] [err $b] [err $c] [regexp {setName} [scripts $b][scripts $c]]
} -result {403 0 {403 400 {access denied (program)}} {404 501 {program not found}} 0}

test programs-29 {delete: ?id= only, administrators only, the program is deleted unless the system's own} -body {
  set a [manage DELETE {} $::FOUND -query id=7]
  set b [manage DELETE {} $::FOUND -query id=7 -sessions $::USER]
  set c [manage DELETE {} {FOUND {true} INTERNAL {true} COPY {false} FULL {true}} -query id=7]
  set d [manage DELETE {} $::FOUND -query id=7a]
  set e [manage DELETE {} $::FOUND -query {}]
  list [status $a] [body $a] [regexp {Unerasable} [scripts $a]] [status $b] [regexp {DeleteObject} [scripts $b]] [err $c] [regexp {DeleteObject} [scripts $c]] [err $d] [err $e]
} -result [list 200 {{"id":"7","deleted":true}} 1 403 0 {403 400 {access denied (program)}} 0 {422 403 {invalid argument (id)}} {422 403 {invalid argument (id)}}]

test programs-30 {a delete ReGa refuses (unerasable) is reported as a failure, not as deleted} -body {
  set rega [list [list $::READ $::FOUND] [list $::DELETE {DELETED {false}}]]
  set r [golden::call_raw {} [golden::prepare [list -candidate $::CAND -method DELETE -contenttype application/json -setenv {REQUEST_URI /api/v2/programs} -query id=7 \
    -header {X-Requested-With XMLHttpRequest} -header {X-Session-Id AbCdEf1234} -sessions $::ADMIN -rega $rega]]]
  err $r
} -result {502 501 {the CCU did not take the change}}

test programs-31 {a CCU that does not answer the change gives HTTP 501, never a success} -body {
  set rega [list [list $::READ $::FOUND] [list $::NAMECHK {TAKEN {false} DONE {true}}]]
  set r [golden::call_raw {{"id":"7","description":"x"}} [golden::prepare [list -candidate $::CAND -method PUT -contenttype application/json -setenv {REQUEST_URI /api/v2/programs} \
    -header {X-Requested-With XMLHttpRequest} -header {X-Session-Id AbCdEf1234} -sessions $::ADMIN -rega $rega]]]
  err $r
} -result {502 501 {the CCU did not take the change}}

# ---- reading the logic of a program (GET ?id=, administrators)
set LOGIC {*RuleSubRule*}
set LOGICOUT [join [list \
  {RULE IDX {0} HASCOND {true}} \
  {COND G {0} GOP {2} S {0} SOP {1} LT {18} LV {3941} CH {3935} CT {1} CT2 {4} RT1 {16} RV1 {1} RT2 {16} RV2 {0} LVN {VirtualDevices.INT0000006:1.CONTROL_MODE} CHN {Kinderzimmer Bennett Gruppe:1} VT {16/29} UNIT {} VN0 {0} VN1 {1} VL {AUTO-MODE;MANU-MODE;PARTY-MODE}} \
  {COND G {0} GOP {2} S {1} SOP {2} LT {24} LV {2025-10-12 08:03:24} CH {65535} CT {3} CT2 {13} RT1 {18} RV1 {23608} RT2 {0} RV2 {} LVN {} CHN {} VT {} UNIT {} VN0 {} VN1 {} VL {}} \
  {TIME TT {9} SOT {0} SEC {23400} DUR {0} TIME {1970-01-01 07:30:00} BEGIN {2025-10-04 00:00:00} END {1970-01-01 01:00:00} REP {0}} \
  {COND G {1} GOP {2} S {0} SOP {1} LT {19} LV {950} CH {65535} CT {8} CT2 {4} RT1 {4} RV1 {20.000000} RT2 {4} RV2 {0.000000} LVN {Name \o mit \c Klammern} CHN {} VT {4/0} UNIT {°C} VN0 {} VN1 {} VL {}} \
  {DESTS BOR {true} COUNT {2}} \
  {DEST P {18} VT {4} VPT {28} V {21.000000} VP {2026-11-04 00:03:00} CH {3935} DP {3943} CHN {Kinderzimmer:1} DPN {VirtualDevices.INT0000006:1.MANU_MODE} DPT {4/0}} \
  {DEST P {20} VT {20} VPT {0} V {if (x) \o\nWrite("a\\b");\n\c} VP {} CH {65535} DP {65535} CHN {} DPN {} DPT {}} \
  {RULE IDX {1} HASCOND {false}} \
  {DESTS BOR {false} COUNT {0}} \
  {END DONE {true}}] "\r\n"]
proc logic {args} {
  array set o [list -sessions $::ADMIN -query id=7 -found $::FOUND -out $::LOGICOUT]
  array set o $args
  set rega [list [list $::READ $o(-found)] [list $::DESCRIBE $::DESC1] [list $::LOGIC $o(-out)]]
  return [golden::call_raw {} [golden::prepare [list -candidate $::CAND -method GET -contenttype {} -setenv {REQUEST_URI /api/v2/programs} -query $o(-query) \
    -header {X-Requested-With XMLHttpRequest} -header {X-Session-Id AbCdEf1234} -sessions $o(-sessions) -rega $rega]]]
}

test programs-40 {the logic of a program is read: rules, groups with their operators, the time module, the actions and the delay} -body {
  set r [logic]
  set b [body $r]
  list [status $r] [regexp {^\{"id":"7","name":"Neu","description":"Text","isActive":false,"isVisible":true,"isOperable":false,"rules":\[\{"hasCondition":true,"groups":\[\{"op":"or","conditions":\[} $b] \
    [regexp {"kind":"device","objectId":"3941","channelId":"3935","objectName":"VirtualDevices.INT0000006:1.CONTROL_MODE","channelName":"Kinderzimmer Bennett Gruppe:1","valueType":"16\\/29","unit":"","valueName0":"0","valueName1":"1","valueList":"AUTO-MODE;MANU-MODE;PARTY-MODE","right":"1","right2":"0","test":1,"trigger":4,"rightType":16,"right2Type":16\}} $b] \
    [regexp {"op":"or","kind":"time".*"time":\{"timerType":9,"sunOffset":0,"seconds":23400,"duration":0,"time":"1970-01-01 07:30:00","begin":"2025-10-04 00:00:00","end":"1970-01-01 01:00:00","repetitions":0\}\}} $b] \
    [regexp {"stopDelays":true,"actions":\[\{"param":18,"valueType":4,"delayType":28,"value":"21.000000","delay":"2026-11-04 00:03:00"} $b] \
    [regexp {\{"hasCondition":false,"groups":\[\],"stopDelays":false,"actions":\[\]\}\]\}$} $b]
} -result {200 1 1 1 1 1}

test programs-41 {braces, backslashes and line breaks in a name or a script come back as they were} -body {
  set b [body [logic]]
  list [regexp {"objectName":"Name \{ mit \} Klammern"} $b] [regexp {"value":"if \(x\) \{\\nWrite\(\\"a\\\\b\\"\);\\n\}"} $b]
} -result {1 1}

test programs-42 {the operators are and / or: the second group joins with the operator of the first, a single with its own} -body {
  set b [body [logic]]
  list [regexp {"groups":\[\{"op":"or","conditions":\[\{"op":"and","kind":"device".*\},\{"op":"or","kind":"time"} $b] [regexp {\}\]\},\{"op":"or","conditions":\[\{"op":"and","kind":"sysvar"} $b]
} -result {1 1}

test programs-43 {only an administrator reads the logic (a user and a guest are 403) and no program script runs for them} -body {
  set a [logic -sessions $::USER]
  set b [logic -sessions $::GUEST]
  list [status $a] [status $b] [progcalls $a] [regexp {RuleSubRule} [scripts $a][scripts $b]]
} -result {403 403 0 0}

test programs-44 {a bad id is 422; an unknown id, a copy is 404; an internal program is 403; nothing is read} -body {
  set out {}
  foreach q {id=x {} id= id=7&a=1} { lappend out [lindex [err [logic -query $q]] 0] }
  set unknown [logic -found {}]
  set copy [logic -found {FOUND {true} INTERNAL {false} COPY {true} FULL {true}}]
  set internal [logic -found {FOUND {true} INTERNAL {true} COPY {false} FULL {true}}]
  lappend out [lindex [err $unknown] 0] [lindex [err $copy] 0] [lindex [err $internal] 0] [regexp {RuleSubRule} [scripts $unknown][scripts $copy][scripts $internal]]
} -result {422 422 422 422 404 404 403 0}

test programs-45 {an answer that stops before the end marker is a failure (HTTP 502), never a half program} -body {
  set cut [join [lrange [split $::LOGICOUT "\n"] 0 4] "\n"]
  err [logic -out $cut]
} -result {502 501 {the CCU did not take the change}}

test programs-46 {the script is fixed text: the id is a variable and it only reads (no write call)} -body {
  set fd [open [file join $gen rega-model v2 programs.tcl] r]; set c [read $fd]; close $fd
  regexp {set PROGRAM_LOGIC_SCRIPT \{.*?\n\}\n\nproc programs_unescape} $c body
  list [regexp {i == progId} $body] [regexp {dom.GetObject\(\$} $body] [regexp {\.(Active|Name|PrgInfo|Visible|Remove|ProgramUpdate|DeleteObject|CreateObject|Destination[A-Za-z]*|OperatorType|ConditionType[0-9]*)\([^)]} $body]
} -result {1 0 0}

cleanupTests
